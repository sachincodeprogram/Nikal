MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/nikal?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=4000
CLIENT_ORIGIN=http://localhost:19006

# Firebase Admin SDK (used to verify phone-OTP ID tokens sent from the mobile app)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps API key (Directions API for a ride's route polyline, and
# Places API for the From/To address autocomplete)
GOOGLE_MAPS_API_KEY=

# Setu DigiLocker (KYC) — from the product instance at https://bridge.setu.co
# (KYC > KYC merchants > your product). Sandbox base URL shown; swap to
# https://dg.setu.co once the product goes live.
SETU_DIGILOCKER_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

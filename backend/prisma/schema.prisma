generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  CAR
  BIKE
}

enum RideStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  phone           String   @unique
  phoneVerified   Boolean  @default(false)
  name            String
  email           String?
  photoUrl        String?
  bio             String?
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicles        Vehicle[]
  ridesAsDriver   Ride[]     @relation("DriverRides")
  bookings        Booking[]  @relation("PassengerBookings")
  ratingsGiven    Rating[]   @relation("RatingsGiven")
  ratingsReceived Rating[]   @relation("RatingsReceived")
}

model Vehicle {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String      @db.ObjectId
  owner       User        @relation(fields: [ownerId], references: [id])
  type        VehicleType
  make        String
  model       String
  color       String
  plateNumber String
  seatCount   Int
  photoUrl    String?
  verified    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  rides       Ride[]

  @@index([ownerId])
}

model Ride {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  driverId        String      @db.ObjectId
  driver          User        @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId       String      @db.ObjectId
  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id])
  vehicleType     VehicleType

  fromLabel       String
  fromLat         Float
  fromLng         Float
  toLabel         String
  toLat           Float
  toLng           Float

  departureAt     DateTime
  totalSeats      Int
  availableSeats  Int
  pricePerSeat    Float
  autoApprove     Boolean     @default(true)
  status          RideStatus  @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bookings        Booking[]

  @@index([fromLat, fromLng])
  @@index([toLat, toLng])
  @@index([departureAt])
  @@index([vehicleType])
}

model Booking {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  rideId       String        @db.ObjectId
  ride         Ride          @relation(fields: [rideId], references: [id])
  passengerId  String        @db.ObjectId
  passenger    User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  seatsBooked  Int           @default(1)
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ratings      Rating[]

  @@index([rideId])
  @@index([passengerId])
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id])
  raterId   String   @db.ObjectId
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId   String   @db.ObjectId
  ratee     User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([bookingId, raterId])
}
